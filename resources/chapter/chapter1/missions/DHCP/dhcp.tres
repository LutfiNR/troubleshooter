script = ExtResource("1_nytc6")
id = "mission2"
title = "DHCP Down"
time = 600.0
check_progress_limit = 8
required_progress_id = "chapter0"
description = "Beberapa komputer di divisi Sales, Media, dan Accounting mengalami masalah koneksi jaringan. Saat komputer dinyalakan, beberapa perangkat tidak mendapatkan alamat IP secara otomatis."
guide = "[center][font_size=26][color=#1565C0][b]DHCP — Komputer Tidak Mendapatkan Alamat IP[/b][/color][/font_size][/center]
[color=#2E7D32][font_size=18][b]Deskripsi[/b][/font_size][/color]
[color=#333333]
Beberapa komputer di [b]Kirin Corp.[/b] mengalami masalah koneksi jaringan.
Saat komputer dinyalakan, beberapa perangkat tidak mendapatkan [b]IP Address[/b] secara otomatis. Akibatnya, komputer tersebut tidak dapat berkomunikasi dengan jaringan perusahaan dengan baik.
Sebagai [b]Network Administrator[/b], Anda diminta untuk memeriksa konfigurasi jaringan, menemukan sumber masalah, dan memastikan komputer client dapat memperoleh konfigurasi jaringan secara otomatis melalui [b]DHCP[/b].
[/color]
[color=#EF6C00][font_size=18][b]Catatan[/b][/font_size][/color]
[color=#333333]
• Jangan mengubah topologi jaringan.
• Jangan menambahkan perangkat baru.
• Periksa konfigurasi perangkat yang tersedia sebelum melakukan perubahan.
• Lakukan perbaikan hanya pada konfigurasi yang diperlukan.
• Pastikan perubahan yang dilakukan tidak mengganggu jaringan atau perangkat lainnya.
[/color]
[hr]
[center]
[color=#2E7D32][font_size=18][b]Topologi Jaringan[/b][/font_size][/color]
[img]res://assets/topology.png[/img]
[/center]
